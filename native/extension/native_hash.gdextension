[configuration]

entry_symbol="native_hash_extension_init"
compatibility_minimum="4.1"

[libraries]

windows.debug.x86_64="res://native/extension/bin/native_hash.windows.debug.x86_64.dll"
windows.release.x86_64="res://native/extension/bin/native_hash.windows.release.x86_64.dll"

android.debug.arm64="res://native/extension/bin/libnative_hash.android.debug.arm64.so"
android.release.arm64="res://native/extension/bin/libnative_hash.android.release.arm64.so"

android.debug.arm32="res://native/extension/bin/libnative_hash.android.debug.arm32.so"
android.release.arm32="res://native/extension/bin/libnative_hash.android.release.arm32.so" 
