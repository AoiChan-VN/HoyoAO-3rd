; =====================================================================
; HoyoAO-3rd — GDExtension Manifest
; Owner: Principal Engineer + C++ Core Directorate
; Law:   Chỉ expose boundary đã kiểm soát (AoiBridge) — không raw internal.
;        reloadable=false: Core là Giám Đốc, không hot-reload giữa runtime.
; =====================================================================
[configuration]

entry_symbol = "aoi_gdext_entry"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

; ---- ANDROID — RELEASE TARGET (Mobile-First: chỉ device thật là chuẩn) ----
android.release.arm64 = "res://addons/aoi_cpp/bin/android/libaoi_cpp.android.arm64-v8a.so"
android.debug.arm64   = "res://addons/aoi_cpp/bin/android/libaoi_cpp.android.arm64-v8a.so"
android.release.arm32 = "res://addons/aoi_cpp/bin/android/libaoi_cpp.android.armeabi-v7a.so"
android.debug.arm32   = "res://addons/aoi_cpp/bin/android/libaoi_cpp.android.armeabi-v7a.so"

; ---- HOST — chỉ phục vụ CI/unit-test, KHÔNG dùng làm chuẩn pass/fail ----
windows.debug.x86_64   = "res://addons/aoi_cpp/bin/windows/aoi_cpp.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/aoi_cpp/bin/windows/aoi_cpp.windows.x86_64.dll"
linux.debug.x86_64     = "res://addons/aoi_cpp/bin/linux/libaoi_cpp.linux.x86_64.so"
linux.release.x86_64   = "res://addons/aoi_cpp/bin/linux/libaoi_cpp.linux.x86_64.so"

[dependencies]

; Không có — aoi_core self-contained, crypto link tĩnh vào adapter. 
